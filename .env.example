# ============================================================================
# TRADYX ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy to .env.local for local development, and configure in Vercel Dashboard
# -> Project Settings -> Environment Variables for Production/Preview.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Bundled in browser via Vite - SAFE to expose)
#    Protected at database level by PostgreSQL Row Level Security (RLS).
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_anon_key"

# ----------------------------------------------------------------------------
# 2. PRIVATE SERVER-ONLY SECRETS (NEVER prefix with VITE_ !)
#    Read exclusively via process.env inside Vercel Serverless Functions (/api/*).
# ----------------------------------------------------------------------------

# Google Gemini AI (Server-side Coach, Ulysses Protocol, Voice, OCR, ATLAS News Impact)
GEMINI_API_KEY="your_google_gemini_api_key"

# Market Data Providers (api/atlas/markets.ts)
TWELVEDATA_API_KEY="your_twelvedata_api_key"
FINNHUB_API_KEY="your_finnhub_api_key"

# Financial News Aggregators (api/atlas/news.ts)
MARKETAUX_API_KEY="your_marketaux_api_key"
NEWSDATA_API_KEY="your_newsdata_api_key"
GNEWS_API_KEY="your_gnews_api_key"

# Macroeconomic Data (api/atlas/macro.ts)
FRED_API_KEY="your_st_louis_fed_fred_api_key"

# Upstash Redis Distributed Cache & Anti-Abuse Rate Limiter (api/_lib/cacheAndRateLimit.ts)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Optional Server-Side Supabase Overrides (if different from VITE_SUPABASE_*)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_publishable_anon_key"
# SUPABASE_SERVICE_ROLE_KEY="" # Only needed for future privileged admin cron jobs
