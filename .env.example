# ============================================================================
# TRADYX ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production/staging secrets.
# ============================================================================

# Supabase Public Client Key (Exposed to client app)
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Secret Keys (REQUIRED ON SERVER / BACKEND ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
GEMINI_API_KEY=your_google_gemini_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
